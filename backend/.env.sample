DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=pokemon_champions

# Port the API listens on (defaults to 3000 if unset)
PORT=3000

# Competitive usage / meta data (championsbattledata.com). Leave enabled to
# auto-refresh on startup + daily. Set to false to run FULLY OFFLINE, no
# network calls at all; the meta/usage features then use whatever is already in
# the DB (or show an "unavailable" note if never synced). The rest of the app
# (Pokedex, calc, team builder, teams, type coverage, lead helper) needs no
# internet regardless.
USAGE_SYNC_ENABLED=true
